<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview of the 1x1 service widget, for launchers that ignore previewLayout. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_tile_background" />
    <item
        android:bottom="30dp"
        android:left="30dp"
        android:right="30dp"
        android:top="20dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_tile_circle" />
        </shape>
    </item>
</layer-list>
