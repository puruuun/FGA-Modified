<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ap_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_stack_card_dark"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:orientation="vertical">

    <!-- StackView sizes every card from the natural width of the first one. This invisible, zero-height
         spacer makes that width huge, so the card is as wide as the stack allows and the bar spans it. -->
    <FrameLayout
        android:layout_width="2000dp"
        android:layout_height="0dp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ap_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ap_item_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ap_item_ap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ap_item_full"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/ap_item_bar_dark"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="1dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:progressDrawable="@drawable/widget_bar_progress" />

    <ProgressBar
        android:id="@+id/ap_item_bar_light"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="1dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:progressDrawable="@drawable/widget_bar_progress_light"
        android:visibility="gone" />
</LinearLayout>
