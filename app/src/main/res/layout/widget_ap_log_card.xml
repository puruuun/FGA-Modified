<?xml version="1.0" encoding="utf-8"?>
<!-- One recent-log card: icon, title and account on the first line, the log list's summary on the second. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ap_log_card"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:background="@drawable/widget_log_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="3dp"
    android:paddingEnd="6dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ap_log_card_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="3dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_swords" />

        <TextView
            android:id="@+id/ap_log_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ap_log_card_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="28dp"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ap_log_card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="10sp" />
</LinearLayout>
